<mxfile host="app.diagrams.net"><diagram name="Architecture" id="arch"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" page="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Smart Parking Reservation System — architecture&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#14213D;" vertex="1" parent="1"><mxGeometry x="36.0" y="12.0" width="900.0" height="42.0" as="geometry"/></mxCell><mxCell id="driver" value="&lt;b&gt;Driver web app (React)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;map search, booking, payment, AI chat&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#8A94A6;fontColor=#14213D;" vertex="1" parent="1"><mxGeometry x="36.0" y="78.0" width="498.0" height="84.0" as="geometry"/></mxCell><mxCell id="owner" value="&lt;b&gt;Owner dashboard (React)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;lots, spaces, rates, reservations, revenue&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#8A94A6;fontColor=#14213D;" vertex="1" parent="1"><mxGeometry x="606.0" y="78.0" width="498.0" height="84.0" as="geometry"/></mxCell><mxCell id="backend" value="&lt;b&gt;FastAPI backend (Python)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E6EAF1;strokeColor=#8A94A6;fontColor=#14213D;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="36.0" y="222.0" width="1068.0" height="180.0" as="geometry"/></mxCell><mxCell id="auth" value="&lt;b&gt;Auth&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;JWT login and roles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#8A94A6;fontColor=#14213D;" vertex="1" parent="1"><mxGeometry x="60.0" y="270.0" width="150.0" height="108.0" as="geometry"/></mxCell><mxCell id="parkings" v